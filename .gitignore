# ==========================================
# 1. Jekyll & Bundler Defaults (Keep These)
# ==========================================
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
.bundle/
vendor/

# ==========================================
# 2. Local Environment & Editor Security
# ==========================================
# Ignore local text editor config/state files (e.g., Kilo editor files)
.kilo/

# Ignore typical OS metadata that leaks path/user structures
.DS_Store
Thumbs.db

# ==========================================
# 3. System & Temporary Files
# ==========================================
# Prevents committing temporary crash/dump logs or retry configurations
*.log
.eslintcache
